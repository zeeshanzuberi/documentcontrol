{
  "heading_styles": {
    "chapter_heading": "Chapter Heading",
    "heading_1": "Heading 1",
    "heading_2": "Heading 2",
    "heading_3": "Heading 3",
    "heading_4": "Heading 4",
    "heading_5": "Heading 5",
    "heading_6": "Heading 6",
    "appendix_heading": "Appendix Heading",
    "section_heading": "Section Heading"
  },
  "paragraph_styles": {
    "body_text": "Body Text",
    "normal": "Normal",
    "note": "Note",
    "caution": "Caution",
    "warning": "Warning",
    "caption": "Caption",
    "table_text": "Table Text",
    "definition": "Definition",
    "reference": "Reference",
    "bullet": "List Bullet"
  },
  "paragraph_numbering_styles": {
    "level_1": "Paragraph Level 1",
    "level_2": "Paragraph Level 2",
    "level_3": "Paragraph Level 3",
    "level_4": "Paragraph Level 4",
    "level_5": "Paragraph Level 5"
  },
  "controlled_paragraph_styles": {
    "old_heading_3_or_level_3": "List_Paragraph_A",
    "old_heading_4_or_level_4": "Style A.1",
    "old_heading_5_or_level_5": "List_Paragraph_i",
    "old_heading_6_or_level_6": "i_list paragraph"
  },
  "table_styles": {
    "default_table": "Airblue Table"
  },
  "style_aliases": {
    "appendix_heading": ["Annex Heading 1", "Annex Heading", "Heading 1"],
    "section_heading": ["Center Heading 1", "Heading 1"],
    "body": ["Normal"],
    "note": ["Note:"],
    "caution": ["CAUTION_Table", "Caution_Table"],
    "warning": ["WARNING", "CAUTION_Table", "Caution_Table"],
    "definition": ["Style A.1", "Body Text", "Normal"],
    "reference": ["Reference TO", "Body Text", "Normal"],
    "paragraph_number_level_1": ["List_Paragraph_A"],
    "paragraph_number_level_2": ["List_Paragraph_1"],
    "paragraph_number_level_3": ["List_Paragraph_a"],
    "paragraph_number_level_4": ["List_paragraph i"],
    "paragraph_number_level_5": ["a) List-paragraph"],
    "controlled_level_3": ["List_Paragraph_A", "Paragraph Level 1", "Body Text", "Normal"],
    "controlled_level_4": ["Style A.1", "Paragraph Level 2", "Body Text", "Normal"],
    "controlled_level_5": ["List_Paragraph_i", "List_paragraph i", "Paragraph Level 4", "Body Text", "Normal"],
    "controlled_level_6": ["i_list paragraph", "i._list paragraph", "Body Text", "Normal"]
  },
  "table_style_aliases": ["Table", "Table Grid"],
  "fallback_style": "Normal",
  "fallback_table_style": "Table Grid",
  "content_bookmarks": [
    "BODY_CONTENT",
    "CONTENT_START",
    "Chapter_0"
  ],
  "content_placeholders": [
    "{{BODY_CONTENT}}"
  ],
  "replace_existing_body_after_bookmark": true,
  "strip_numbering_when_style_has_auto_numbering": true,
  "update_fields_on_open": true,
  "revision_bars": {
    "enabled_by_default": false,
    "color": "000000",
    "size": "6",
    "space": "8"
  },
  "source_style_map": {
    "Chapter Heading": "chapter_heading",
    "Appendix Heading": "appendix_heading",
    "Annex Heading 1": "appendix_heading",
    "Section Heading": "section_heading",
    "Center Heading 1": "section_heading",
    "Heading 1": "heading_1",
    "Heading 2": "heading_2",
    "Heading 3": "controlled_level_3",
    "Heading 4": "controlled_level_4",
    "Heading 5": "controlled_level_5",
    "Heading 6": "controlled_level_6",
    "Paragraph Level 1": "paragraph_number_level_1",
    "Paragraph Level 2": "paragraph_number_level_2",
    "Paragraph Level 3": "paragraph_number_level_3",
    "Paragraph Level 4": "paragraph_number_level_4",
    "Paragraph Level 5": "paragraph_number_level_5",
    "List_Paragraph_A": "paragraph_number_level_1",
    "List_Paragraph_1": "paragraph_number_level_2",
    "List_Paragraph_a": "paragraph_number_level_3",
    "List_paragraph i": "paragraph_number_level_4",
    "a) List-paragraph": "paragraph_number_level_5",
    "List Bullet": "bullet",
    "Caption": "caption",
    "Note": "note",
    "Note:": "note",
    "CAUTION_Table": "caution",
    "Caution_Table": "caution",
    "Style A.1": "definition",
    "Reference TO": "reference"
  }
}
